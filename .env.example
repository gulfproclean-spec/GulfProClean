# Local development (SQLite) — this is the default, works with no setup
DATABASE_URL="file:./dev.db"

# For production on Postgres (Neon, Supabase, Vercel Postgres, etc.) set this
# to your connection string instead, and change the provider in
# prisma/schema.prisma from "sqlite" to "postgresql". See README.md.
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
